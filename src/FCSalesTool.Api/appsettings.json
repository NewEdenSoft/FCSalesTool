{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  // Every app setting, with its default. Local dev sets these through the AppHost
  // (src/FCSalesTool.AppHost/AppHost.cs); production sets them as environment variables
  // (e.g. App__PublicBaseUrl). Never commit secrets here. See AGENTS.md "Configuration".
  // ConnectionStrings:fcsalestool is required (Aspire injects it locally).
  // Database:MigrateOnStartup (bool) defaults to true in Development, false elsewhere.
  "App": {
    "SiteName": "OmegaWatch",
    // Required outside Development: public origin used in email links, e.g. https://omegawatch.example
    "PublicBaseUrl": null
  },
  "Auth": {
    // Per-IP limit for login, register and email-sending endpoints.
    "RateLimitPerMinute": 20,
    "Eve": {
      // Optional: empty disables EVE SSO. ClientSecret is a secret.
      "ClientId": "",
      "ClientSecret": "",
      // Space-separated ESI scopes; empty = authentication only.
      "Scopes": ""
    }
  },
  "Email": {
    "FromAddress": "no-reply@omegawatch.local",
    "FromName": "OmegaWatch",
    "Smtp": {
      // Required outside Development (Development logs emails when unset).
      "Host": null,
      "Port": 587,
      "Username": null,
      // Secret.
      "Password": null,
      // Auto | None | StartTls | SslOnConnect
      "Security": "Auto"
    }
  }
}

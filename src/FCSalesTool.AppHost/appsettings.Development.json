{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  // Local dev configuration for the API, passed through as environment variables (see AppHost.cs
  // and AGENTS.md "Configuration"). This file is committed: keep it free of secrets.
  // Put real values in appsettings.Development.local.json next to it (git-ignored, same shape,
  // overrides this file), or in the AppHost's user secrets.
  "Parameters": {
    // EVE SSO app (developers.eveonline.com), callback http://localhost:5173/auth/eve/callback,
    // no scopes. Leave empty to run without EVE sign-in (the buttons are hidden).
    "eve-client-id": "",
    "eve-client-secret": "",
    // Space-separated ESI scopes. Empty = authentication only.
    "eve-scopes": "",
    // Sender of account emails (they land in Mailpit locally).
    "email-from-address": "no-reply@omegawatch.local",
    "email-from-name": "OmegaWatch"
  }
}
